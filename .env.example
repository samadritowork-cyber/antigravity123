# FinSight Environment Configuration
PROJECT_NAME="FinSight AI Analytics & Risk Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
DATABASE_URL="postgresql://finsight_user:finsight_pass@localhost:5432/finsight_db"

# LLM & RAG Configuration (All external keys are proxied via Backend ONLY)
LLM_PROVIDER="openai" # Options: openai, google, mock
LLM_API_KEY="your-api-key-here"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# Market Data Ingestion Configuration
MARKET_DATA_PROVIDER="yfinance" # Abstracted provider: yfinance, mock

# Logging & Security
LOG_LEVEL="INFO"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
